{
  "name": "secret-santa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve secret-santa",
    "start:es": "nx serve secret-santa --configuration=es-MX --port 4201",
    "start:backoffice": "nx serve backoffice --port 4202",
    "start:hosting": "npm run build:hosting && firebase emulators:start --only hosting --project secret-santa-jgu7man",
    "build": "nx build secret-santa",
    "build:es": "nx build secret-santa --localize=es-MX",
    "build:backoffice": "nx build backoffice",
    "build:hosting": "nx build secret-santa && node --experimental-strip-types scripts/prepare-hosting.ts",
    "watch": "nx build secret-santa --watch --configuration development",
    "test": "nx run-many -t test --no-watch --no-progress --browsers=ChromeHeadless",
    "extract-i18n": "nx extract-i18n secret-santa --output-path apps/secret-santa/src/locale"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/localize": "^19.2.17",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@nx/angular": "23.0.2",
    "firebase": "^12.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.19",
    "@angular-devkit/core": "^19.2.19",
    "@angular-devkit/schematics": "^19.2.19",
    "@angular/cli": "^19.2.19",
    "@angular/compiler-cli": "^19.2.0",
    "@nx/angular": "23.0.2",
    "@nx/workspace": "23.0.2",
    "@schematics/angular": "^19.2.19",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.22",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nx": "23.0.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2"
  }
}
