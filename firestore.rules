rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: events/{eventId}
// Fields:
//   - adminToken: string - Secret token for guest host event management
//   - name: string - Event title
//   - minAmount: number - Minimum gift budget
//   - maxAmount: number | null (optional) - Maximum gift budget
//   - revealToHost: bool - Whether host can view raffle assignments
//   - isRegistrationOpen: bool - Whether new participants can join
//   - status: string ('CREATED' | 'DRAWN') - Current raffle status
//   - createdAt: timestamp - Creation timestamp
//   - ownerId: string | null (optional) - Firebase Auth UID of event owner
//   - participantUids: list<string> (optional) - UIDs of registered participants
//   - registrationDeadline: timestamp (optional) - Registration cutoff date
//
// Subcollection: events/{eventId}/participants/{participantId}
// Fields:
//   - uid: string (optional) - Linked Firebase Auth UID
//   - name: string - Display name within the event
//   - normalizedName: string - Lowercased trimmed name for uniqueness checks
//   - secretWord: string (optional) - Participant passphrase for guest login
//   - email: string (optional) - Participant email for UID linking
//   - preferences: map ({ general: string, sizes?: string }) - Gift wishlist
//   - assignedToId: string | null - Assigned recipient participant ID
//   - assignedToName: string | null - Assigned recipient participant name
//
// Collection: users/{userId}
// Document ID: Firebase Auth UID
// Fields:
//   - uid: string (required, immutable, == userId) - User's Firebase Auth UID
//   - email: string (required, 1..320 chars) - User email address
//   - displayName: string (required, 0..200 chars) - Display name
//   - photoURL: string | null (optional, 0..2048 chars) - Avatar URL
//   - role: string (required, 'USER' | 'HOST' | 'ADMIN') - RBAC role
//   - status: string (required, 'ACTIVE' | 'SUSPENDED') - Account status
//   - createdAt: timestamp (required, immutable) - Account creation timestamp
//   - lastLoginAt: timestamp (required) - Last login timestamp
//   - notes: string | null (optional, 0..2000 chars) - Backoffice admin notes
//   - acceptedInviteId: string | null (optional, 1..128 chars) - Accepted admin invite ID
//
// Collection: accessRequests/{requestId}
// Document ID: Auto-generated or client-generated request ID
// Fields:
//   - id: string (required, immutable, == requestId, 1..128 chars) - Request ID
//   - email: string (required, immutable, 1..320 chars) - Requester email
//   - displayName: string (required, 1..200 chars) - Requester display name
//   - uid: string | null (optional, 1..128 chars) - Firebase Auth UID if Google auth
//   - source: string (required, immutable, 'GOOGLE' | 'EMAIL') - Request origin
//   - reason: string | null (optional, 0..500 chars) - Access request reason
//   - status: string (required, 'PENDING' | 'APPROVED' | 'REJECTED') - Review status
//   - createdAt: timestamp (required, immutable) - Creation timestamp
//   - reviewedAt: timestamp | null (optional) - Review timestamp
//   - reviewedBy: string | null (optional, 1..320 chars) - Reviewing admin identifier
//   - inviteId: string | null (optional, 1..128 chars) - Issued invite ID if approved
//
// Collection: adminInvites/{inviteId}
// Document ID: Unguessable invite token ID
// Fields:
//   - id: string (required, immutable, == inviteId, 1..128 chars) - Invite ID
//   - email: string (required, immutable, 1..320 chars) - Invited user email
//   - targetRole: string (required, 'USER' | 'HOST' | 'ADMIN') - Role granted upon acceptance
//   - status: string (required, 'PENDING' | 'ACCEPTED' | 'REVOKED') - Invite status
//   - requiresProfileCompletion: bool (required) - Whether profile setup is required
//   - createdAt: timestamp (required, immutable) - Creation timestamp
//   - expiresAt: timestamp (required) - Expiration timestamp
//   - createdBy: string (required, immutable, 1..320 chars) - Creating admin identifier
//   - acceptedAt: timestamp | null (optional) - Acceptance timestamp
//   - acceptedByUid: string | null (optional, 1..128 chars) - Accepting user UID
//   - requestId: string | null (optional, 1..128 chars) - Linked accessRequest ID
//
// Collection: appConfig/{configId} (e.g., appConfig/global)
// Fields:
//   - maintenanceMode: bool (required) - Global maintenance toggle
//   - maintenanceMessage: string (required, 0..1000 chars) - Maintenance banner text
//   - allowGuestEventCreation: bool (required) - Toggle anonymous event creation
//   - allowNewRegistrations: bool (required) - Toggle new participant registrations
//   - defaultMinAmount: number (required, >= 0) - Default minimum gift amount
//   - maxParticipantsPerEvent: int (required, 2..1000) - Participant cap per event
//   - announcementEnabled: bool (required) - Global announcement banner toggle
//   - announcementText: string (required, 0..1000 chars) - Global announcement text
//   - updatedAt: timestamp (required) - Last update timestamp
//   - updatedBy: string (required, 1..320 chars) - UID or identifier of updating admin
//
// Collection: apps/{appId}
// Document ID: Application identifier (e.g., 'secret-santa', 'backoffice')
// Fields:
//   - id: string (required, == appId, 1..64 chars) - App identifier
//   - name: string (required, 1..120 chars) - App display name
//   - maintenanceMode: bool (required) - App maintenance toggle
//   - maintenanceMessage: string (required, 0..1000 chars) - Maintenance banner text
//   - allowGuestEventCreation: bool (required) - Toggle anonymous event creation
//   - allowNewRegistrations: bool (required) - Toggle new participant registrations
//   - defaultMinAmount: number (required, 0..100000000) - Default minimum gift amount
//   - maxParticipantsPerEvent: int (required, 2..1000) - Participant cap per event
//   - announcementEnabled: bool (required) - App announcement banner toggle
//   - announcementText: string (required, 0..1000 chars) - App announcement text
//   - auth: map (required) - Auth & invite runtime configuration
//   - updatedAt: timestamp (required) - Last update timestamp
//   - updatedBy: string (required, 1..320 chars) - UID or identifier of updating admin
//
// Subcollection: apps/{appId}/releases/{releaseId}
// Document ID: Release identifier
// Fields:
//   - id: string (required, == releaseId, 1..128 chars) - Release ID
//   - version: string (required, 1..50 chars) - Release version string
//   - environment: string (required, 'DEV' | 'BETA' | 'PROD') - Target environment
//   - notes: string (required, 0..2000 chars) - Release notes
//   - createdAt: timestamp (required) - Creation timestamp
//   - createdBy: string (required, 1..320 chars) - Creating admin identifier
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidOptionalTimestamp(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is timestamp;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data, userId) {
      return hasRequiredFields([
               'uid',
               'email',
               'displayName',
               'role',
               'status',
               'createdAt',
               'lastLoginAt'
             ]) &&
             hasOnlyAllowedFields([
               'uid',
               'email',
               'displayName',
               'photoURL',
               'role',
               'status',
               'createdAt',
               'lastLoginAt',
               'notes',
               'acceptedInviteId'
             ]) &&
             data.uid is string &&
             data.uid == userId &&
             data.uid.size() > 0 &&
             data.uid.size() <= 128 &&
             data.email is string &&
             data.email.size() > 0 &&
             data.email.size() <= 320 &&
             data.displayName is string &&
             data.displayName.size() <= 200 &&
             isValidOptionalString('photoURL', 0, 2048) &&
             data.role is string &&
             data.role in ['USER', 'HOST', 'ADMIN'] &&
             data.status is string &&
             data.status in ['ACTIVE', 'SUSPENDED'] &&
             data.createdAt is timestamp &&
             data.lastLoginAt is timestamp &&
             isValidOptionalString('notes', 0, 2000) &&
             isValidOptionalString('acceptedInviteId', 1, 128);
    }

    function isValidSelfUserCreate(userId) {
      return isOwner(userId) &&
             isValidUser(request.resource.data, userId) &&
             request.resource.data.role == 'USER' &&
             request.resource.data.status == 'ACTIVE' &&
             (!('notes' in request.resource.data) || request.resource.data.notes == null) &&
             (!('acceptedInviteId' in request.resource.data) || request.resource.data.acceptedInviteId == null);
    }

    function isValidSelfUserUpdate(userId) {
      return isOwner(userId) &&
             isValidUser(request.resource.data, userId) &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['email', 'displayName', 'photoURL', 'lastLoginAt']) &&
             areImmutableFieldsUnchanged(['uid', 'role', 'status', 'createdAt', 'notes', 'acceptedInviteId']);
    }

    function matchesValidPendingInvite(userId, inviteId) {
      let inviteBefore = get(/databases/$(database)/documents/adminInvites/$(inviteId)).data;
      let inviteAfter = getAfter(/databases/$(database)/documents/adminInvites/$(inviteId)).data;
      return exists(/databases/$(database)/documents/adminInvites/$(inviteId)) &&
             inviteBefore.status == 'PENDING' &&
             inviteBefore.email == request.auth.token.email &&
             request.time < inviteBefore.expiresAt &&
             inviteBefore.targetRole == request.resource.data.role &&
             inviteAfter.status == 'ACCEPTED' &&
             inviteAfter.acceptedByUid == userId;
    }

    function isValidInviteAcceptance(userId) {
      return isOwner(userId) &&
             request.auth.token.email_verified == true &&
             'acceptedInviteId' in request.resource.data &&
             request.resource.data.acceptedInviteId is string &&
             request.resource.data.acceptedInviteId.size() >= 1 &&
             request.resource.data.acceptedInviteId.size() <= 128 &&
             request.resource.data.status == 'ACTIVE' &&
             matchesValidPendingInvite(userId, request.resource.data.acceptedInviteId);
    }

    function isValidInviteUserCreate(userId) {
      return isValidUser(request.resource.data, userId) &&
             isValidInviteAcceptance(userId) &&
             (!('notes' in request.resource.data) || request.resource.data.notes == null);
    }

    function isValidInviteUserUpdate(userId) {
      return isValidUser(request.resource.data, userId) &&
             isValidInviteAcceptance(userId) &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'status', 'acceptedInviteId', 'email', 'displayName', 'photoURL', 'lastLoginAt']) &&
             areImmutableFieldsUnchanged(['uid', 'createdAt', 'notes']);
    }

    function isValidAdminUserUpdate(userId) {
      return isAdmin() &&
             isValidUser(request.resource.data, userId) &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'status', 'notes', 'displayName', 'email', 'photoURL', 'lastLoginAt']) &&
             areImmutableFieldsUnchanged(['uid', 'createdAt', 'acceptedInviteId']);
    }

    function isValidAccessRequest(data, requestId) {
      return hasRequiredFields([
               'id',
               'email',
               'displayName',
               'source',
               'status',
               'createdAt'
             ]) &&
             hasOnlyAllowedFields([
               'id',
               'email',
               'displayName',
               'uid',
               'source',
               'reason',
               'status',
               'createdAt',
               'reviewedAt',
               'reviewedBy',
               'inviteId'
             ]) &&
             data.id is string &&
             data.id == requestId &&
             data.id.size() >= 1 &&
             data.id.size() <= 128 &&
             data.email is string &&
             data.email.size() >= 1 &&
             data.email.size() <= 320 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 200 &&
             isValidOptionalString('uid', 1, 128) &&
             data.source is string &&
             data.source in ['GOOGLE', 'EMAIL'] &&
             isValidOptionalString('reason', 0, 500) &&
             data.status is string &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.createdAt is timestamp &&
             isValidOptionalTimestamp('reviewedAt') &&
             isValidOptionalString('reviewedBy', 1, 320) &&
             isValidOptionalString('inviteId', 1, 128);
    }

    function isValidAdminInvite(data, inviteId) {
      return hasRequiredFields([
               'id',
               'email',
               'targetRole',
               'status',
               'requiresProfileCompletion',
               'createdAt',
               'expiresAt',
               'createdBy'
             ]) &&
             hasOnlyAllowedFields([
               'id',
               'email',
               'targetRole',
               'status',
               'requiresProfileCompletion',
               'createdAt',
               'expiresAt',
               'createdBy',
               'acceptedAt',
               'acceptedByUid',
               'requestId'
             ]) &&
             data.id is string &&
             data.id == inviteId &&
             data.id.size() >= 1 &&
             data.id.size() <= 128 &&
             data.email is string &&
             data.email.size() >= 1 &&
             data.email.size() <= 320 &&
             data.targetRole is string &&
             data.targetRole in ['USER', 'HOST', 'ADMIN'] &&
             data.status is string &&
             data.status in ['PENDING', 'ACCEPTED', 'REVOKED'] &&
             data.requiresProfileCompletion is bool &&
             data.createdAt is timestamp &&
             data.expiresAt is timestamp &&
             data.createdBy is string &&
             data.createdBy.size() >= 1 &&
             data.createdBy.size() <= 320 &&
             isValidOptionalTimestamp('acceptedAt') &&
             isValidOptionalString('acceptedByUid', 1, 128) &&
             isValidOptionalString('requestId', 1, 128);
    }

    function isValidAppConfig(data) {
      return hasRequiredFields([
               'maintenanceMode',
               'maintenanceMessage',
               'allowGuestEventCreation',
               'allowNewRegistrations',
               'defaultMinAmount',
               'maxParticipantsPerEvent',
               'announcementEnabled',
               'announcementText',
               'updatedAt',
               'updatedBy'
             ]) &&
             hasOnlyAllowedFields([
               'maintenanceMode',
               'maintenanceMessage',
               'allowGuestEventCreation',
               'allowNewRegistrations',
               'defaultMinAmount',
               'maxParticipantsPerEvent',
               'announcementEnabled',
               'announcementText',
               'updatedAt',
               'updatedBy'
             ]) &&
             data.maintenanceMode is bool &&
             data.maintenanceMessage is string &&
             data.maintenanceMessage.size() <= 1000 &&
             data.allowGuestEventCreation is bool &&
             data.allowNewRegistrations is bool &&
             data.defaultMinAmount is number &&
             data.defaultMinAmount >= 0 &&
             data.defaultMinAmount <= 100000000 &&
             data.maxParticipantsPerEvent is int &&
             data.maxParticipantsPerEvent >= 2 &&
             data.maxParticipantsPerEvent <= 1000 &&
             data.announcementEnabled is bool &&
             data.announcementText is string &&
             data.announcementText.size() <= 1000 &&
             data.updatedAt is timestamp &&
             data.updatedBy is string &&
             data.updatedBy.size() > 0 &&
             data.updatedBy.size() <= 320;
    }

    function isValidAppAuth(auth) {
      return auth is map &&
             auth.keys().hasAll([
               'brandName',
               'appName',
               'postLoginRedirectUrl',
               'loginRoute',
               'requestAccessRoute',
               'inviteBasePath',
               'requiresProfileCompletionByDefault',
               'defaultTargetRole',
               'inviteExpirationHours',
               'allowedAdminRoles'
             ]) &&
             auth.keys().hasOnly([
               'brandName',
               'appName',
               'postLoginRedirectUrl',
               'loginRoute',
               'requestAccessRoute',
               'inviteBasePath',
               'requiresProfileCompletionByDefault',
               'defaultTargetRole',
               'inviteExpirationHours',
               'allowedAdminRoles'
             ]) &&
             auth.brandName is string &&
             auth.brandName.size() >= 1 &&
             auth.brandName.size() <= 120 &&
             auth.appName is string &&
             auth.appName.size() >= 1 &&
             auth.appName.size() <= 120 &&
             auth.postLoginRedirectUrl is string &&
             auth.postLoginRedirectUrl.size() >= 1 &&
             auth.postLoginRedirectUrl.size() <= 200 &&
             auth.loginRoute is string &&
             auth.loginRoute.size() >= 1 &&
             auth.loginRoute.size() <= 200 &&
             auth.requestAccessRoute is string &&
             auth.requestAccessRoute.size() >= 1 &&
             auth.requestAccessRoute.size() <= 200 &&
             auth.inviteBasePath is string &&
             auth.inviteBasePath.size() >= 1 &&
             auth.inviteBasePath.size() <= 200 &&
             auth.requiresProfileCompletionByDefault is bool &&
             auth.defaultTargetRole is string &&
             auth.defaultTargetRole in ['USER', 'HOST', 'ADMIN'] &&
             auth.inviteExpirationHours is int &&
             auth.inviteExpirationHours >= 1 &&
             auth.inviteExpirationHours <= 720 &&
             auth.allowedAdminRoles is list &&
             auth.allowedAdminRoles.size() >= 1 &&
             auth.allowedAdminRoles.size() <= 3 &&
             auth.allowedAdminRoles.hasOnly(['USER', 'HOST', 'ADMIN']);
    }

    function isValidAppDoc(data, appId) {
      return data.keys().hasAll([
               'id',
               'name',
               'maintenanceMode',
               'maintenanceMessage',
               'allowGuestEventCreation',
               'allowNewRegistrations',
               'defaultMinAmount',
               'maxParticipantsPerEvent',
               'announcementEnabled',
               'announcementText',
               'auth',
               'updatedAt',
               'updatedBy'
             ]) &&
             data.keys().hasOnly([
               'id',
               'name',
               'maintenanceMode',
               'maintenanceMessage',
               'allowGuestEventCreation',
               'allowNewRegistrations',
               'defaultMinAmount',
               'maxParticipantsPerEvent',
               'announcementEnabled',
               'announcementText',
               'auth',
               'updatedAt',
               'updatedBy'
             ]) &&
             data.id is string &&
             data.id == appId &&
             data.id.size() >= 1 &&
             data.id.size() <= 64 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 120 &&
             data.maintenanceMode is bool &&
             data.maintenanceMessage is string &&
             data.maintenanceMessage.size() <= 1000 &&
             data.allowGuestEventCreation is bool &&
             data.allowNewRegistrations is bool &&
             data.defaultMinAmount is number &&
             data.defaultMinAmount >= 0 &&
             data.defaultMinAmount <= 100000000 &&
             data.maxParticipantsPerEvent is int &&
             data.maxParticipantsPerEvent >= 2 &&
             data.maxParticipantsPerEvent <= 1000 &&
             data.announcementEnabled is bool &&
             data.announcementText is string &&
             data.announcementText.size() <= 1000 &&
             isValidAppAuth(data.auth) &&
             data.updatedAt is timestamp &&
             data.updatedBy is string &&
             data.updatedBy.size() >= 1 &&
             data.updatedBy.size() <= 320;
    }

    function isValidAppRelease(data, releaseId) {
      return data.keys().hasAll([
               'id',
               'version',
               'environment',
               'notes',
               'createdAt',
               'createdBy'
             ]) &&
             data.keys().hasOnly([
               'id',
               'version',
               'environment',
               'notes',
               'createdAt',
               'createdBy'
             ]) &&
             data.id is string &&
             data.id == releaseId &&
             data.id.size() >= 1 &&
             data.id.size() <= 128 &&
             data.version is string &&
             data.version.size() >= 1 &&
             data.version.size() <= 50 &&
             data.environment is string &&
             data.environment in ['DEV', 'BETA', 'PROD'] &&
             data.notes is string &&
             data.notes.size() <= 2000 &&
             data.createdAt is timestamp &&
             data.createdBy is string &&
             data.createdBy.size() >= 1 &&
             data.createdBy.size() <= 320;
    }

    // ===============================================================
    // Secret Santa Events & Participants (Public App + Backoffice)
    // ===============================================================

    // Events are readable by anyone with the event ID (and active admins)
    match /events/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() ||
                    request.auth != null ||
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'isRegistrationOpen']);
      allow delete: if isAdmin() ||
                    (request.auth != null && request.auth.uid == resource.data.ownerId);

      // Participants sub-collection
      match /participants/{participantId} {
        allow read: if true;
        allow create: if isAdmin() ||
                      get(/databases/$(database)/documents/events/$(eventId)).data.isRegistrationOpen == true;
        allow update: if true;
        allow delete: if isAdmin() ||
                      (request.auth != null && request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.ownerId);
      }
    }

    // ===============================================================
    // Backoffice Users Collection
    // ===============================================================

    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if (isAdmin() && isValidUser(request.resource.data, userId)) ||
                    isValidSelfUserCreate(userId) ||
                    isValidInviteUserCreate(userId);
      allow update: if isValidSelfUserUpdate(userId) ||
                    isValidInviteUserUpdate(userId) ||
                    isValidAdminUserUpdate(userId);
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ===============================================================
    // Access Requests Collection
    // ===============================================================

    match /accessRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if isValidAccessRequest(request.resource.data, requestId) &&
                    request.resource.data.status == 'PENDING' &&
                    !('reviewedAt' in request.resource.data) &&
                    !('reviewedBy' in request.resource.data) &&
                    !('inviteId' in request.resource.data) &&
                    (request.resource.data.source != 'GOOGLE' ||
                      (isAuthenticated() &&
                       'uid' in request.resource.data &&
                       request.resource.data.uid == request.auth.uid)) &&
                    (request.resource.data.source != 'EMAIL' ||
                      !('uid' in request.resource.data) ||
                      request.resource.data.uid == null ||
                      (isAuthenticated() && request.resource.data.uid == request.auth.uid));
      allow update: if isAdmin() &&
                    isValidAccessRequest(request.resource.data, requestId) &&
                    areImmutableFieldsUnchanged(['id', 'email', 'source', 'createdAt']);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Admin Invites Collection
    // ===============================================================

    match /adminInvites/{inviteId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() &&
                    isValidAdminInvite(request.resource.data, inviteId) &&
                    request.resource.data.status == 'PENDING' &&
                    request.resource.data.expiresAt > request.time &&
                    (!('acceptedAt' in request.resource.data) || request.resource.data.acceptedAt == null) &&
                    (!('acceptedByUid' in request.resource.data) || request.resource.data.acceptedByUid == null);
      allow update: if isValidAdminInvite(request.resource.data, inviteId) &&
                    ((isAdmin() &&
                      areImmutableFieldsUnchanged(['id', 'email', 'createdAt', 'createdBy'])) ||
                     (isAuthenticated() &&
                      request.auth.token.email_verified == true &&
                      request.auth.token.email == resource.data.email &&
                      resource.data.status == 'PENDING' &&
                      request.time < resource.data.expiresAt &&
                      request.resource.data.status == 'ACCEPTED' &&
                      request.resource.data.acceptedByUid == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'acceptedAt', 'acceptedByUid']) &&
                      request.resource.data.acceptedAt is timestamp));
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Global Application Configuration
    // ===============================================================

    match /appConfig/{configId} {
      allow read: if true;
      allow create: if isAdmin() && isValidAppConfig(request.resource.data);
      allow update: if isAdmin() && isValidAppConfig(request.resource.data);
      allow delete: if false;
    }

    // ===============================================================
    // Per-App Runtime Configuration & Releases
    // ===============================================================

    match /apps/{appId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidAppDoc(request.resource.data, appId);
      allow delete: if false;

      match /releases/{releaseId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && isValidAppRelease(request.resource.data, releaseId);
        allow update: if isAdmin() && isValidAppRelease(request.resource.data, releaseId);
        allow delete: if isAdmin();
      }
    }
  }
}
