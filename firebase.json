{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "hosting": {
      "port": 5050
    }
  },
  "hosting": [
    {
      "target": "santa-secreto",
      "public": "dist/apps/secret-santa/hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/es/",
          "type": 302
        },
        {
          "source": "/event/:rest*",
          "destination": "/es/event/:rest*",
          "type": 302
        },
        {
          "source": "/admin/:rest*",
          "destination": "/es/admin/:rest*",
          "type": 302
        },
        {
          "source": "/dashboard",
          "destination": "/es/dashboard",
          "type": 302
        },
        {
          "source": "/login",
          "destination": "/es/login",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "/es/**",
          "destination": "/es/index.html"
        },
        {
          "source": "/en/**",
          "destination": "/en/index.html"
        },
        {
          "source": "**",
          "destination": "/es/index.html"
        }
      ]
    },
    {
      "target": "santa-secreto-backoffice",
      "public": "dist/apps/backoffice/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
